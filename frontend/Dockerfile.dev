# 使用 Node.js 22 Alpine 版本作为基础镜像
FROM node:22-alpine

# 运行时用户（与宿主机一致，避免 bind mount 和匿名卷的权限问题）
# 由 docker-compose.dev.yml 以 build args 传入
ARG UID=1000
ARG GID=1000

# 设置工作目录
WORKDIR /app

# 安装 pnpm（锁定 v10，与 lockfileVersion 9 配套；v10 默认拦截构建脚本，
# 需配合 package.json 中 pnpm.onlyBuiltDependencies 放行）
RUN npm install -g pnpm@10

# 复制依赖定义文件
# 利用 Docker 缓存层，只有依赖变化时才重新执行安装
COPY package.json pnpm-lock.yaml ./

# 安装依赖
# --frozen-lockfile 确保安装的版本与 lock 文件一致
RUN pnpm install --frozen-lockfile

# 把镜像内文件属主改为运行时用户：
# /app/node_modules 在运行时是匿名卷，Docker 会用镜像内文件的属主初始化它；
# 若保持 root 属主而容器以 ${UID}:${GID} 运行，Turbopack 写缓存会 Permission denied
RUN chown -R ${UID}:${GID} /app

# 复制所有源代码
COPY . .

# 暴露 Next.js 默认的开发端口
EXPOSE 3000

# 设置环境变量，确保 Next.js 在 Docker 容器中正确监听
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# 启动开发服务器
CMD ["pnpm", "run", "dev"]
